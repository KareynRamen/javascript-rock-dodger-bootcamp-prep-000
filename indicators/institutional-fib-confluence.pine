//@version=6
indicator("Institutional Fib Confluence — NQ/ES/GC", shorttitle = "Fib Confluence", overlay = true, max_labels_count = 200, max_lines_count = 200)

// =====================================================================================
// Structure-break Fibonacci confluence indicator (NQ / ES / GC).
//
// Anchoring model (matches a manually-drawn break-of-structure Fib):
//   Anchor 0 ("Entry Zone")  = the swing point that was just broken (the BOS pivot)
//   Anchor 1 ("Origin")      = the prior opposite swing that started that impulse leg
//   0.382 / 0.5              = "Confluence Zone" — primary pullback area to look for a
//                              reversal pattern back in the direction of the break
//   0.786                    = "Breakout Pattern" — deep zone; a close through it means
//                              the breakout failed, and the structure is invalidated
//   -0.27 / -0.618 / -1.272  = TP1 / TP2 / Alpha — staged continuation targets beyond
//                              the Entry Zone, in the direction of the break
//
// For a bearish break of structure everything mirrors: Entry Zone sits at the broken
// swing low, targets extend below it, Confluence/Breakout Pattern sit above it.
//
// A call only fires once price is back in a pullback zone (Confluence or a retest of
// the Entry Zone) with a reversal bar, AND at least `minConfluence` of the independent
// TA/cross-market factors below also line up.
// =====================================================================================

// ---------------------------------------------------------------------------- Inputs
grpStruct = "Structure (Break of Structure)"
pivotLen = input.int(10, "Swing Pivot Lookback (bars each side)", group = grpStruct, minval = 2)

grpFib = "Fib Ratios (your template)"
rConfluenceA   = input.float(0.382, "Confluence Zone — near bound", group = grpFib, step = 0.001)
rConfluenceB   = input.float(0.5,   "Confluence Zone — far bound", group = grpFib, step = 0.001)
rBreakoutPtn   = input.float(0.786, "Breakout Pattern (invalidation)", group = grpFib, step = 0.001)
rTP1           = input.float(-0.27,  "Take Profit 1", group = grpFib, step = 0.001)
rTP2           = input.float(-0.618, "Take Profit 2", group = grpFib, step = 0.001)
rAlpha         = input.float(-1.272, "Alpha (final target)", group = grpFib, step = 0.001)

grpTa = "Technical Confirmation"
rsiLen    = input.int(14, "RSI Length", group = grpTa)
rsiOB     = input.int(70, "RSI Overbought", group = grpTa)
rsiOS     = input.int(30, "RSI Oversold", group = grpTa)
emaFastLen = input.int(21, "Fast EMA", group = grpTa)
emaSlowLen = input.int(50, "Slow EMA", group = grpTa)
macdFast   = input.int(12, "MACD Fast", group = grpTa)
macdSlow   = input.int(26, "MACD Slow", group = grpTa)
macdSigLen = input.int(9, "MACD Signal", group = grpTa)
volLen     = input.int(20, "Volume MA Length", group = grpTa)

grpCorr = "Cross-Market Correlation (Institutional Confirmation)"
useCorrelation = input.bool(true, "Require Cross-Market Confirmation Factor", group = grpCorr)
esSymbol = input.symbol("CME_MINI:ES1!", "ES Symbol", group = grpCorr)
nqSymbol = input.symbol("CME_MINI:NQ1!", "NQ Symbol", group = grpCorr)
gcSymbol = input.symbol("COMEX:GC1!", "GC Symbol", group = grpCorr)

grpSig = "Confluence & Risk"
minConfluence  = input.int(3, "Minimum Confluences Required", group = grpSig, minval = 2, maxval = 6)
cooldownBars   = input.int(10, "Cooldown Between Calls (bars)", group = grpSig, minval = 0)
atrLen         = input.int(14, "ATR Length (stop/tolerance buffer)", group = grpSig)
atrMultStop    = input.float(1.0, "ATR Multiplier — Stop Buffer", group = grpSig, step = 0.1)
entryZoneAtrTol = input.float(0.25, "Entry Zone Retest Tolerance (x ATR)", group = grpSig, step = 0.05)

grpDisp = "Display"
showTable  = input.bool(true, "Show Status Table", group = grpDisp)
showLevels = input.bool(true, "Plot Fib Levels", group = grpDisp)

// ------------------------------------------------------------------ Structure (BOS)
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

var float lastPH = na
var int lastPHBar = na
var float lastPL = na
var int lastPLBar = na

if not na(ph)
    lastPH := ph
    lastPHBar := bar_index - pivotLen
if not na(pl)
    lastPL := pl
    lastPLBar := bar_index - pivotLen

bullBOS = not na(lastPH) and not na(lastPL) and lastPHBar > lastPLBar and ta.crossover(close, lastPH)
bearBOS = not na(lastPH) and not na(lastPL) and lastPLBar > lastPHBar and ta.crossunder(close, lastPL)

var string bias = ""
var float anchor0 = na
var float anchor1 = na

if bullBOS
    bias := "bull"
    anchor0 := lastPH
    anchor1 := lastPL
if bearBOS
    bias := "bear"
    anchor0 := lastPL
    anchor1 := lastPH

isBull = bias == "bull"
isBear = bias == "bear"

range_ = isBull ? anchor0 - anchor1 : isBear ? anchor1 - anchor0 : na

level(r) =>
    isBull ? anchor0 - range_ * r : isBear ? anchor0 + range_ * r : na

entryZone    = level(0.0)
confA        = level(rConfluenceA)
confB        = level(rConfluenceB)
confTop      = math.max(confA, confB)
confBot      = math.min(confA, confB)
breakoutPtn  = level(rBreakoutPtn)
tp1          = level(rTP1)
tp2          = level(rTP2)
alpha        = level(rAlpha)
origin       = level(1.0)

plot(showLevels ? entryZone   : na, "Entry Zone",     color = color.new(color.gray, 20))
plot(showLevels ? confA       : na, "Confluence A",   color = color.new(color.yellow, 10))
plot(showLevels ? confB       : na, "Confluence B",   color = color.new(#d8c96a, 10))
plot(showLevels ? breakoutPtn : na, "Breakout Pattern", color = color.new(color.orange, 10))
plot(showLevels ? tp1         : na, "TP1",             color = color.new(#4fa8e0, 10))
plot(showLevels ? tp2         : na, "TP2",             color = color.new(color.blue, 10))
plot(showLevels ? alpha       : na, "Alpha",           color = color.new(color.purple, 10))
plot(showLevels ? origin      : na, "Origin",          color = color.new(color.gray, 70), style = plot.style_circles)

// ------------------------------------------------------------------------- Trend
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaUptrend   = emaFast > emaSlow
emaDowntrend = emaFast < emaSlow

// -------------------------------------------------------------------- Momentum TA
rsi = ta.rsi(close, rsiLen)
bullRsiConfirm = rsi > rsi[1] and rsi[1] <= rsiOS + 15
bearRsiConfirm = rsi < rsi[1] and rsi[1] >= rsiOB - 15

[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSigLen)
bullMacdConfirm = macdLine > macdSignal and macdHist > macdHist[1]
bearMacdConfirm = macdLine < macdSignal and macdHist < macdHist[1]

volMA = ta.sma(volume, volLen)
volConfirm = volume > volMA

atr = ta.atr(atrLen)

// --------------------------------------------------------------- Pullback zone / bar
inConfluenceZone = (isBull or isBear) and low <= confTop and high >= confBot
entryZoneTouch   = (isBull or isBear) and math.abs(close - entryZone) <= atr * entryZoneAtrTol

inPullbackZone = inConfluenceZone or entryZoneTouch

bullReversalBar = close > (high + low) / 2 and close > open
bearReversalBar = close < (high + low) / 2 and close < open

// --------------------------------------------------------- Cross-market correlation
isES = syminfo.root == "ES"
isNQ = syminfo.root == "NQ"
isGC = syminfo.root == "GC"

esClose = request.security(esSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
nqClose = request.security(nqSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
gcClose = request.security(gcSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

esEmaFast = ta.ema(esClose, emaFastLen)
nqEmaFast = ta.ema(nqClose, emaFastLen)
gcEmaFast = ta.ema(gcClose, emaFastLen)

esUp = esClose > esEmaFast
nqUp = nqClose > nqEmaFast
gcUp = gcClose > gcEmaFast

// Equity vs equity: the other index trending the same way validates the tape.
// Equity vs gold: a clean risk-on rally shouldn't be accompanied by an aggressive gold
// bid, and a clean risk-off breakdown is validated by gold being bid (flight to safety).
// Gold itself is read in reverse: it should rally when equities are weak, and sell off
// when equities are strong.
bullCorrConfirm = useCorrelation ? (isNQ ? esUp and not gcUp : isES ? nqUp and not gcUp : isGC ? not esUp and not nqUp : false) : false
bearCorrConfirm = useCorrelation ? (isNQ ? not esUp and gcUp : isES ? not nqUp and gcUp : isGC ? esUp and nqUp : false) : false

// ------------------------------------------------------------------- Confluence count
bullFactors = (emaUptrend ? 1 : 0) + (inConfluenceZone ? 1 : 0) + (bullRsiConfirm ? 1 : 0) + (bullMacdConfirm ? 1 : 0) + (volConfirm ? 1 : 0) + (bullCorrConfirm ? 1 : 0)
bearFactors = (emaDowntrend ? 1 : 0) + (inConfluenceZone ? 1 : 0) + (bearRsiConfirm ? 1 : 0) + (bearMacdConfirm ? 1 : 0) + (volConfirm ? 1 : 0) + (bearCorrConfirm ? 1 : 0)

// A close through the Breakout Pattern level (0.786) toward the origin means the
// break of structure failed — invalidate the current bias.
breakoutPtnBroken = isBull ? close < breakoutPtn : isBear ? close > breakoutPtn : false

var int lastSignalBar = na
cooledDown = na(lastSignalBar) or (bar_index - lastSignalBar) > cooldownBars

bullSetup = isBull and inPullbackZone and bullReversalBar and not breakoutPtnBroken
bearSetup = isBear and inPullbackZone and bearReversalBar and not breakoutPtnBroken

bullCall = bullSetup and bullFactors >= minConfluence and cooledDown and barstate.isconfirmed
bearCall = bearSetup and bearFactors >= minConfluence and cooledDown and barstate.isconfirmed

if bullCall or bearCall
    lastSignalBar := bar_index

// ------------------------------------------------------------------------ Trade plan
bullStop = breakoutPtn - atr * atrMultStop
bearStop = breakoutPtn + atr * atrMultStop

bullRR = math.abs(tp1 - close) / math.abs(close - bullStop)
bearRR = math.abs(close - tp1) / math.abs(bearStop - close)

// ------------------------------------------------------------------------------ Labels
buildCallText(isCallBull, factors, entry, stop, t1, t2, a, rr) =>
    dir = isCallBull ? "LONG" : "SHORT"
    zoneName = inConfluenceZone ? "Confluence Zone" : "Entry Zone Retest"
    tags = array.new<string>()
    array.push(tags, zoneName)
    if isCallBull ? emaUptrend : emaDowntrend
        array.push(tags, "EMA Trend")
    if isCallBull ? bullRsiConfirm : bearRsiConfirm
        array.push(tags, "RSI Turn")
    if isCallBull ? bullMacdConfirm : bearMacdConfirm
        array.push(tags, "MACD Turn")
    if volConfirm
        array.push(tags, "Volume")
    if isCallBull ? bullCorrConfirm : bearCorrConfirm
        array.push(tags, "Cross-Market")
    "INSTITUTIONAL " + dir + " — " + syminfo.root + "\n" +
     "Confluence " + str.tostring(factors) + "/6: " + array.join(tags, ", ") + "\n" +
     "Entry " + str.tostring(entry, format.mintick) +
     " | Stop " + str.tostring(stop, format.mintick) +
     " | TP1 " + str.tostring(t1, format.mintick) +
     " | TP2 " + str.tostring(t2, format.mintick) +
     " | Alpha " + str.tostring(a, format.mintick) + "\n" +
     "R:R to TP1 " + str.tostring(rr, "#.##")

if bullCall
    label.new(bar_index, low - atr, buildCallText(true, bullFactors, close, bullStop, tp1, tp2, alpha, bullRR),
         style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)

if bearCall
    label.new(bar_index, high + atr, buildCallText(false, bearFactors, close, bearStop, tp1, tp2, alpha, bearRR),
         style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.small)

// --------------------------------------------------------------------------- Alerts
alertcondition(bullCall, "Institutional Long Call", "Institutional Fib Confluence: LONG setup on {{ticker}} — {{close}}")
alertcondition(bearCall, "Institutional Short Call", "Institutional Fib Confluence: SHORT setup on {{ticker}} — {{close}}")
alertcondition(breakoutPtnBroken, "Structure Invalidated", "Institutional Fib Confluence: Breakout Pattern level broken on {{ticker}} — bias invalidated")

// --------------------------------------------------------------------------- Status table
var table statusTable = table.new(position.top_right, 2, 8, border_width = 1)

if showTable and barstate.islast
    biasLabel = isBull ? "BULL BOS" : isBear ? "BEAR BOS" : "NONE"
    zoneLabel = inConfluenceZone ? "Confluence" : entryZoneTouch ? "Entry Retest" : "—"
    table.cell(statusTable, 0, 0, "Symbol", bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 1, 0, syminfo.root, bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 0, 1, "Structure")
    table.cell(statusTable, 1, 1, biasLabel)
    table.cell(statusTable, 0, 2, "Zone")
    table.cell(statusTable, 1, 2, zoneLabel)
    table.cell(statusTable, 0, 3, "RSI")
    table.cell(statusTable, 1, 3, str.tostring(rsi, "#.#"))
    table.cell(statusTable, 0, 4, "MACD")
    table.cell(statusTable, 1, 4, macdLine > macdSignal ? "Bull" : "Bear")
    table.cell(statusTable, 0, 5, "Volume")
    table.cell(statusTable, 1, 5, volConfirm ? "Above Avg" : "Below Avg")
    table.cell(statusTable, 0, 6, "Cross-Market")
    table.cell(statusTable, 1, 6, useCorrelation ? (bullCorrConfirm ? "Bull Confirm" : bearCorrConfirm ? "Bear Confirm" : "Neutral") : "Off")
    table.cell(statusTable, 0, 7, "Confluence", bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 1, 7, str.tostring(isBull ? bullFactors : isBear ? bearFactors : 0) + "/6", bgcolor = color.new(color.gray, 60))

// ---------------------------------------------------------------- Invalidation reset
if breakoutPtnBroken
    bias := ""
