//@version=6
indicator("Institutional Fib Confluence — NQ/ES/GC", shorttitle = "Fib Confluence", overlay = true, max_labels_count = 200, max_lines_count = 200)

// =====================================================================================
// Institutional-style confluence indicator.
// Applies to a chart of NQ1!, ES1!, or GC1! (root symbol auto-detected via syminfo.root).
// A "call" fires only when at least `minConfluence` of the following line up:
//   1) Trend direction (EMA fast/slow)
//   2) Price sitting in the 38.2%-78.6% Fibonacci retracement zone with a reversal bar
//   3) RSI momentum turn
//   4) MACD momentum turn
//   5) Above-average volume (participation)
//   6) Cross-market correlation/regime confirmation from the other two futures
// Trend + Fib zone are prerequisites for a setup to exist at all, so reaching the
// default minimum of 3 always means at least one independent TA or cross-market
// confirmation on top of the base pattern.
// =====================================================================================

// ---------------------------------------------------------------------------- Inputs
grpFib = "Fibonacci Retracement"
swingLen           = input.int(20, "Swing Lookback (bars)", group = grpFib, minval = 5)

grpTa = "Technical Confirmation"
rsiLen    = input.int(14, "RSI Length", group = grpTa)
rsiOB     = input.int(70, "RSI Overbought", group = grpTa)
rsiOS     = input.int(30, "RSI Oversold", group = grpTa)
emaFastLen = input.int(21, "Fast EMA", group = grpTa)
emaSlowLen = input.int(50, "Slow EMA", group = grpTa)
macdFast   = input.int(12, "MACD Fast", group = grpTa)
macdSlow   = input.int(26, "MACD Slow", group = grpTa)
macdSigLen = input.int(9, "MACD Signal", group = grpTa)
volLen     = input.int(20, "Volume MA Length", group = grpTa)

grpCorr = "Cross-Market Correlation (Institutional Confirmation)"
useCorrelation = input.bool(true, "Require Cross-Market Confirmation Factor", group = grpCorr)
esSymbol = input.symbol("CME_MINI:ES1!", "ES Symbol", group = grpCorr)
nqSymbol = input.symbol("CME_MINI:NQ1!", "NQ Symbol", group = grpCorr)
gcSymbol = input.symbol("COMEX:GC1!", "GC Symbol", group = grpCorr)
corrLen  = input.int(20, "Correlation Length", group = grpCorr)

grpSig = "Confluence & Risk"
minConfluence  = input.int(3, "Minimum Confluences Required", group = grpSig, minval = 2, maxval = 6)
cooldownBars   = input.int(10, "Cooldown Between Calls (bars)", group = grpSig, minval = 0)
atrLen         = input.int(14, "ATR Length (stop distance)", group = grpSig)
atrMultStop    = input.float(1.5, "ATR Multiplier — Stop", group = grpSig, step = 0.1)
extPct         = input.float(0.272, "Stretch Target Extension", group = grpSig, step = 0.01)

grpDisp = "Display"
showTable  = input.bool(true, "Show Status Table", group = grpDisp)
showLevels = input.bool(true, "Plot Fib Levels", group = grpDisp)

// ---------------------------------------------------------------------- Fib levels
swingHigh   = ta.highest(high, swingLen)
swingLow    = ta.lowest(low, swingLen)
swingRange  = swingHigh - swingLow

fib236 = swingHigh - swingRange * 0.236
fib382 = swingHigh - swingRange * 0.382
fib50  = swingHigh - swingRange * 0.5
fib618 = swingHigh - swingRange * 0.618
fib786 = swingHigh - swingRange * 0.786

zoneTop = fib382
zoneBot = fib786

plot(showLevels ? fib236 : na, "Fib 23.6", color = color.new(color.gray, 40), style = plot.style_circles)
plot(showLevels ? fib382 : na, "Fib 38.2", color = color.new(color.orange, 20))
plot(showLevels ? fib50  : na, "Fib 50.0", color = color.new(color.yellow, 20))
plot(showLevels ? fib618 : na, "Fib 61.8", color = color.new(color.orange, 20))
plot(showLevels ? fib786 : na, "Fib 78.6", color = color.new(color.gray, 40), style = plot.style_circles)

nearestFibName() =>
    d236 = math.abs(close - fib236)
    d382 = math.abs(close - fib382)
    d50  = math.abs(close - fib50)
    d618 = math.abs(close - fib618)
    d786 = math.abs(close - fib786)
    dMin = math.min(d236, math.min(d382, math.min(d50, math.min(d618, d786))))
    dMin == d236 ? "23.6%" : dMin == d382 ? "38.2%" : dMin == d50 ? "50.0%" : dMin == d618 ? "61.8%" : "78.6%"

// ------------------------------------------------------------------------- Trend
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
isUptrend   = emaFast > emaSlow
isDowntrend = emaFast < emaSlow

// -------------------------------------------------------------------- Momentum TA
rsi = ta.rsi(close, rsiLen)
bullRsiConfirm = rsi > rsi[1] and rsi[1] <= rsiOS + 15
bearRsiConfirm = rsi < rsi[1] and rsi[1] >= rsiOB - 15

[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSigLen)
bullMacdConfirm = macdLine > macdSignal and macdHist > macdHist[1]
bearMacdConfirm = macdLine < macdSignal and macdHist < macdHist[1]

volMA = ta.sma(volume, volLen)
volConfirm = volume > volMA

atr = ta.atr(atrLen)

// -------------------------------------------------------------- Fib pullback setup
pulledIntoZone   = low <= zoneTop and low >= zoneBot
pulledIntoZoneUp = high >= zoneBot and high <= zoneTop

bullReversalBar = close > (high + low) / 2 and close > open
bearReversalBar = close < (high + low) / 2 and close < open

bullFibSetup = isUptrend and pulledIntoZone and bullReversalBar
bearFibSetup = isDowntrend and pulledIntoZoneUp and bearReversalBar

// --------------------------------------------------------- Cross-market correlation
isES = syminfo.root == "ES"
isNQ = syminfo.root == "NQ"
isGC = syminfo.root == "GC"

esClose = request.security(esSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
nqClose = request.security(nqSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
gcClose = request.security(gcSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

esEmaFast = ta.ema(esClose, emaFastLen)
nqEmaFast = ta.ema(nqClose, emaFastLen)
gcEmaFast = ta.ema(gcClose, emaFastLen)

esUp = esClose > esEmaFast
nqUp = nqClose > nqEmaFast
gcUp = gcClose > gcEmaFast

// Cross-asset regime read:
//  - Equity vs equity: the other index trending the same way validates the tape (not a lone-stock/lone-future move).
//  - Equity vs gold: a clean risk-on rally should NOT be accompanied by an aggressive gold bid, and a clean
//    risk-off breakdown is validated by gold being bid (flight to safety). Gold itself is read in reverse:
//    it should be rallying when equities are weak, and offered when equities are strong.
bullCorrConfirm = useCorrelation ? (isNQ ? esUp and not gcUp : isES ? nqUp and not gcUp : isGC ? not esUp and not nqUp : false) : false
bearCorrConfirm = useCorrelation ? (isNQ ? not esUp and gcUp : isES ? not nqUp and gcUp : isGC ? esUp and nqUp : false) : false

// ------------------------------------------------------------------- Confluence count
bullFactors = (isUptrend ? 1 : 0) + (bullFibSetup ? 1 : 0) + (bullRsiConfirm ? 1 : 0) + (bullMacdConfirm ? 1 : 0) + (volConfirm ? 1 : 0) + (bullCorrConfirm ? 1 : 0)
bearFactors = (isDowntrend ? 1 : 0) + (bearFibSetup ? 1 : 0) + (bearRsiConfirm ? 1 : 0) + (bearMacdConfirm ? 1 : 0) + (volConfirm ? 1 : 0) + (bearCorrConfirm ? 1 : 0)

var int lastSignalBar = na
cooledDown = na(lastSignalBar) or (bar_index - lastSignalBar) > cooldownBars

bullCall = bullFibSetup and bullFactors >= minConfluence and cooledDown and barstate.isconfirmed
bearCall = bearFibSetup and bearFactors >= minConfluence and cooledDown and barstate.isconfirmed

if bullCall or bearCall
    lastSignalBar := bar_index

// ------------------------------------------------------------------------ Trade plan
bullStop   = math.min(low, zoneBot) - atr * atrMultStop
bullTarget = swingHigh
bullStretch = swingHigh + swingRange * extPct
bullRR = math.abs(bullTarget - close) / math.abs(close - bullStop)

bearStop   = math.max(high, zoneTop) + atr * atrMultStop
bearTarget = swingLow
bearStretch = swingLow - swingRange * extPct
bearRR = math.abs(close - bearTarget) / math.abs(bearStop - close)

// ------------------------------------------------------------------------------ Labels
buildCallText(isBull, factors, entry, stop, target, stretch, rr) =>
    dir = isBull ? "LONG" : "SHORT"
    tags = array.new<string>()
    if isUptrend or isDowntrend
        array.push(tags, "Trend")
    array.push(tags, "Fib " + nearestFibName())
    if isBull ? bullRsiConfirm : bearRsiConfirm
        array.push(tags, "RSI Turn")
    if isBull ? bullMacdConfirm : bearMacdConfirm
        array.push(tags, "MACD Turn")
    if volConfirm
        array.push(tags, "Volume")
    if isBull ? bullCorrConfirm : bearCorrConfirm
        array.push(tags, "Cross-Market")
    "INSTITUTIONAL " + dir + " — " + syminfo.root + "\n" +
     "Confluence " + str.tostring(factors) + "/6: " + array.join(tags, ", ") + "\n" +
     "Entry " + str.tostring(entry, format.mintick) +
     " | Stop " + str.tostring(stop, format.mintick) +
     " | Target " + str.tostring(target, format.mintick) +
     " | Stretch " + str.tostring(stretch, format.mintick) + "\n" +
     "R:R " + str.tostring(rr, "#.##")

if bullCall
    label.new(bar_index, low - atr, buildCallText(true, bullFactors, close, bullStop, bullTarget, bullStretch, bullRR),
         style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)

if bearCall
    label.new(bar_index, high + atr, buildCallText(false, bearFactors, close, bearStop, bearTarget, bearStretch, bearRR),
         style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.small)

// --------------------------------------------------------------------------- Alerts
alertcondition(bullCall, "Institutional Long Call", "Institutional Fib Confluence: LONG setup on {{ticker}} — {{close}}")
alertcondition(bearCall, "Institutional Short Call", "Institutional Fib Confluence: SHORT setup on {{ticker}} — {{close}}")

// --------------------------------------------------------------------------- Status table
var table statusTable = table.new(position.top_right, 2, 8, border_width = 1)

if showTable and barstate.islast
    bias = isUptrend ? "UP" : isDowntrend ? "DOWN" : "FLAT"
    table.cell(statusTable, 0, 0, "Symbol", bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 1, 0, syminfo.root, bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 0, 1, "Trend")
    table.cell(statusTable, 1, 1, bias)
    table.cell(statusTable, 0, 2, "Fib Zone")
    table.cell(statusTable, 1, 2, nearestFibName() + (pulledIntoZone or pulledIntoZoneUp ? " (in zone)" : ""))
    table.cell(statusTable, 0, 3, "RSI")
    table.cell(statusTable, 1, 3, str.tostring(rsi, "#.#"))
    table.cell(statusTable, 0, 4, "MACD")
    table.cell(statusTable, 1, 4, macdLine > macdSignal ? "Bull" : "Bear")
    table.cell(statusTable, 0, 5, "Volume")
    table.cell(statusTable, 1, 5, volConfirm ? "Above Avg" : "Below Avg")
    table.cell(statusTable, 0, 6, "Cross-Market")
    table.cell(statusTable, 1, 6, useCorrelation ? (bullCorrConfirm ? "Bull Confirm" : bearCorrConfirm ? "Bear Confirm" : "Neutral") : "Off")
    table.cell(statusTable, 0, 7, "Confluence", bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 1, 7, str.tostring(math.max(bullFactors, bearFactors)) + "/6", bgcolor = color.new(color.gray, 60))
