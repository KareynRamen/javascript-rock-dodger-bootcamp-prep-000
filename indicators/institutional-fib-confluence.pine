//@version=6
indicator("Institutional Fib Confluence — NQ/ES/GC", shorttitle = "FibConf", overlay = true, max_labels_count = 200, max_lines_count = 200, max_boxes_count = 50)

// =====================================================================================
// Structure-break Fibonacci confluence indicator (NQ / ES / GC).
//
// Anchoring model (matches a manually-drawn break-of-structure Fib):
//   Anchor 0 ("Entry Zone")  = the swing point that was just broken (the BOS pivot)
//   Anchor 1 ("Origin")      = the prior opposite swing that started that impulse leg
//   0.382 / 0.5              = "Confluence Zone" — primary pullback area to look for a
//                              reversal pattern back in the direction of the break
//   0.786                    = "Breakout Pattern" — deep zone; a close through it means
//                              the breakout failed, and the structure is invalidated
//   -0.27 / -0.618 / -1.272  = TP1 / TP2 / Alpha — staged continuation targets beyond
//                              the Entry Zone, in the direction of the break
//
// For a bearish break of structure everything mirrors: Entry Zone sits at the broken
// swing low, targets extend below it, Confluence/Breakout Pattern sit above it.
//
// A call fires once price is in a pullback zone with a reversal bar, the HTF bias
// agrees (if required), and at least `minConfluence` of 5 factors agree: Confluence
// Zone quality, Momentum turn (RSI or MACD), Volume, Cross-market correlation, and a
// Liquidity Sweep. The call label always states which of those five it is ("Why:").
//
// Volume itself is a composite, not a single check: relative volume vs. its average,
// On-Balance Volume vs. its own trend, and Chaikin Money Flow must all agree with the
// trade direction. VWAP is plotted for reference, and ADX/DMI trend strength is an
// optional filter (like HTF/session) that can require a trending regime without
// changing the /5 scoring.
// =====================================================================================

// ---------------------------------------------------------------------------- Inputs
grpStruct = "Structure (Break of Structure)"
pivotLen      = input.int(10, "Swing Pivot Lookback (bars each side)", group = grpStruct, minval = 2)
sweepLookback = input.int(8, "Liquidity Sweep Lookback (bars)", group = grpStruct, minval = 2)

grpHtf = "Higher-Timeframe Bias Filter"
requireHtfAlignment = input.bool(true, "Require HTF Trend Alignment", group = grpHtf)
htfTimeframe         = input.timeframe("240", "Higher Timeframe", group = grpHtf)

grpSession = "Session Filter"
useSessionFilter = input.bool(false, "Restrict Calls to Session", group = grpSession)
sessionString    = input.session("0930-1600", "Session (exchange local time)", group = grpSession)
sessionTimezone  = input.string("America/New_York", "Session Timezone", group = grpSession)

grpFib = "Fib Ratios (your template)"
rConfluenceA   = input.float(0.382, "Confluence Zone — near bound", group = grpFib, step = 0.001)
rConfluenceB   = input.float(0.5,   "Confluence Zone — far bound", group = grpFib, step = 0.001)
rBreakoutPtn   = input.float(0.786, "Breakout Pattern (invalidation)", group = grpFib, step = 0.001)
rTP1           = input.float(-0.27,  "Take Profit 1", group = grpFib, step = 0.001)
rTP2           = input.float(-0.618, "Take Profit 2", group = grpFib, step = 0.001)
rAlpha         = input.float(-1.272, "Alpha (final target)", group = grpFib, step = 0.001)

grpTa = "Technical Confirmation"
rsiLen    = input.int(14, "RSI Length", group = grpTa)
rsiOB     = input.int(70, "RSI Overbought", group = grpTa)
rsiOS     = input.int(30, "RSI Oversold", group = grpTa)
emaFastLen = input.int(21, "Fast EMA (HTF & cross-market)", group = grpTa)
emaSlowLen = input.int(50, "Slow EMA (HTF & cross-market)", group = grpTa)
macdFast   = input.int(12, "MACD Fast", group = grpTa)
macdSlow   = input.int(26, "MACD Slow", group = grpTa)
macdSigLen = input.int(9, "MACD Signal", group = grpTa)

grpVol = "Volume Analysis"
volLen         = input.int(20, "Volume / CMF / OBV Length", group = grpVol)
rvolThreshold  = input.float(1.2, "Relative Volume Threshold (x average)", group = grpVol, step = 0.1)
obvTrendLen    = input.int(20, "OBV Trend EMA Length", group = grpVol)

grpTrend = "Trend Strength (ADX/DMI)"
requireTrendStrength = input.bool(false, "Require Trending Regime (ADX)", group = grpTrend)
adxLen         = input.int(14, "DMI Length", group = grpTrend)
adxSmoothing   = input.int(14, "ADX Smoothing", group = grpTrend)
adxThreshold   = input.int(20, "ADX Threshold", group = grpTrend)

grpCorr = "Cross-Market Correlation (Institutional Confirmation)"
useCorrelation = input.bool(true, "Require Cross-Market Confirmation Factor", group = grpCorr)
esSymbol = input.symbol("CME_MINI:ES1!", "ES Symbol", group = grpCorr)
nqSymbol = input.symbol("CME_MINI:NQ1!", "NQ Symbol", group = grpCorr)
gcSymbol = input.symbol("COMEX:GC1!", "GC Symbol", group = grpCorr)
corrLen  = input.int(20, "Correlation Length", group = grpCorr)

grpSig = "Confluence & Risk"
minConfluence  = input.int(3, "Minimum Confluences Required (of 5)", group = grpSig, minval = 2, maxval = 5)
cooldownBars   = input.int(10, "Cooldown Between Calls (bars)", group = grpSig, minval = 0)
atrLen         = input.int(14, "ATR Length (stop/tolerance buffer)", group = grpSig)
atrMultStop    = input.float(1.0, "ATR Multiplier — Stop Buffer", group = grpSig, step = 0.1)
entryZoneAtrTol = input.float(0.25, "Entry Zone Retest Tolerance (x ATR)", group = grpSig, step = 0.05)

grpDisp = "Display"
showTable   = input.bool(true, "Show Status Table", group = grpDisp)
showLevels  = input.bool(true, "Plot Fib Levels + Stop", group = grpDisp)
showZoneBox = input.bool(true, "Show Confluence Zone Box", group = grpDisp)
showVwap    = input.bool(true, "Plot Session VWAP", group = grpDisp)

// ------------------------------------------------------------------ Structure (BOS)
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

var float lastPH = na
var int lastPHBar = na
var float lastPL = na
var int lastPLBar = na

if not na(ph)
    lastPH := ph
    lastPHBar := bar_index - pivotLen
if not na(pl)
    lastPL := pl
    lastPLBar := bar_index - pivotLen

// Hoisted out of the conditional so these always evaluate on every bar (Pine flags
// ta.* calls embedded inside a chained "and" as potentially inconsistent otherwise).
crossedAboveLastPH = ta.crossover(close, lastPH)
crossedBelowLastPL = ta.crossunder(close, lastPL)

bullBOS = not na(lastPH) and not na(lastPL) and lastPHBar > lastPLBar and crossedAboveLastPH
bearBOS = not na(lastPH) and not na(lastPL) and lastPLBar > lastPHBar and crossedBelowLastPL

var string bias = ""
var float anchor0 = na
var float anchor1 = na

if bullBOS
    bias := "bull"
    anchor0 := lastPH
    anchor1 := lastPL
if bearBOS
    bias := "bear"
    anchor0 := lastPL
    anchor1 := lastPH

isBull = bias == "bull"
isBear = bias == "bear"

range_ = isBull ? anchor0 - anchor1 : isBear ? anchor1 - anchor0 : na

level(r) =>
    isBull ? anchor0 - range_ * r : isBear ? anchor0 + range_ * r : na

entryZone    = level(0.0)
confA        = level(rConfluenceA)
confB        = level(rConfluenceB)
confTop      = math.max(confA, confB)
confBot      = math.min(confA, confB)
breakoutPtn  = level(rBreakoutPtn)
tp1          = level(rTP1)
tp2          = level(rTP2)
alpha        = level(rAlpha)
origin       = level(1.0)

var box confBox = na
if (bullBOS or bearBOS) and showZoneBox
    box.delete(confBox)
    confBox := box.new(bar_index, confTop, bar_index, confBot, border_color = color.new(color.yellow, 40), bgcolor = color.new(color.yellow, 88), extend = extend.right)

plot(showLevels ? entryZone   : na, "Entry Zone",       color = color.new(color.gray, 20))
plot(showLevels ? breakoutPtn : na, "Breakout Pattern", color = color.new(color.orange, 10))
plot(showLevels ? tp1         : na, "TP1",              color = color.new(#4fa8e0, 10))
plot(showLevels ? tp2         : na, "TP2",              color = color.new(color.blue, 10))
plot(showLevels ? alpha       : na, "Alpha",            color = color.new(color.purple, 10))
plot(showLevels ? origin      : na, "Origin",           color = color.new(color.gray, 70), style = plot.style_circles)

// -------------------------------------------------------------------------- HTF bias
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
htfEmaFast = ta.ema(htfClose, emaFastLen)
htfEmaSlow = ta.ema(htfClose, emaSlowLen)
htfUptrend   = htfEmaFast > htfEmaSlow
htfDowntrend = htfEmaFast < htfEmaSlow

// -------------------------------------------------------------------- Momentum TA
rsi = ta.rsi(close, rsiLen)
bullRsiConfirm = rsi > rsi[1] and rsi[1] <= rsiOS + 15
bearRsiConfirm = rsi < rsi[1] and rsi[1] >= rsiOB - 15

[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSigLen)
bullMacdConfirm = macdLine > macdSignal and macdHist > macdHist[1]
bearMacdConfirm = macdLine < macdSignal and macdHist < macdHist[1]

bullMomentum = bullRsiConfirm or bullMacdConfirm
bearMomentum = bearRsiConfirm or bearMacdConfirm

// Trend strength: ADX/DMI, used as an optional filter (like HTF/session) rather than
// a 6th scored factor, so it can tighten signal quality without changing the /5 scale.
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmoothing)
trending = adxVal >= adxThreshold

// ---------------------------------------------------------------------- Volume analysis
// Relative volume: participation vs. its own average.
volMA = ta.sma(volume, volLen)
rvol = volume / volMA

// On-Balance Volume, read against its own trend (accumulation/distribution direction).
var float obv = 0.0
obv := obv + (close > close[1] ? volume : close < close[1] ? -volume : 0)
obvEma = ta.ema(obv, obvTrendLen)
obvUp   = obv > obvEma
obvDown = obv < obvEma

// Chaikin Money Flow: net buying/selling pressure over the same lookback.
mfMultiplier = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
mfVolume = mfMultiplier * volume
cmf = math.sum(mfVolume, volLen) / math.sum(volume, volLen)

// Composite volume confirmation: above-average participation AND OBV AND CMF all
// agreeing with the trade direction — a real volume read, not just "above average".
bullVolConfirm = rvol >= rvolThreshold and obvUp and cmf > 0
bearVolConfirm = rvol >= rvolThreshold and obvDown and cmf < 0

atr = ta.atr(atrLen)

// VWAP — session-anchored, for visual/institutional reference (resets each session).
vwapVal = ta.vwap(hlc3)
plot(showVwap ? vwapVal : na, "VWAP", color = color.new(#8a8fa3, 0), linewidth = 1)

// --------------------------------------------------------------- Pullback zone / bar
inConfluenceZone = (isBull or isBear) and low <= confTop and high >= confBot
entryZoneTouch   = (isBull or isBear) and math.abs(close - entryZone) <= atr * entryZoneAtrTol

inPullbackZone = inConfluenceZone or entryZoneTouch

bullReversalBar = close > (high + low) / 2 and close > open
bearReversalBar = close < (high + low) / 2 and close < open

// Liquidity sweep: a wick takes out the recent range extreme (stop hunt) and the bar
// reclaims it — a stronger tell than a plain reversal bar on its own.
sweepRefLow  = ta.lowest(low[1], sweepLookback)
sweepRefHigh = ta.highest(high[1], sweepLookback)
bullSweep = low < sweepRefLow and close > sweepRefLow
bearSweep = high > sweepRefHigh and close < sweepRefHigh

// ------------------------------------------------------------------------ Session
inSession = not na(time(timeframe.period, sessionString, sessionTimezone))

// --------------------------------------------------------- Cross-market correlation
isES = syminfo.root == "ES"
isNQ = syminfo.root == "NQ"
isGC = syminfo.root == "GC"

esClose = request.security(esSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
nqClose = request.security(nqSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
gcClose = request.security(gcSymbol, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

esEmaFast = ta.ema(esClose, emaFastLen)
nqEmaFast = ta.ema(nqClose, emaFastLen)
gcEmaFast = ta.ema(gcClose, emaFastLen)

esUp = esClose > esEmaFast
nqUp = nqClose > nqEmaFast
gcUp = gcClose > gcEmaFast

// Equity vs equity: the other index trending the same way validates the tape.
// Equity vs gold: a clean risk-on rally shouldn't be accompanied by an aggressive gold
// bid, and a clean risk-off breakdown is validated by gold being bid (flight to safety).
// Gold itself is read in reverse: it should rally when equities are weak, and sell off
// when equities are strong.
bullCorrConfirm = useCorrelation ? (isNQ ? esUp and not gcUp : isES ? nqUp and not gcUp : isGC ? not esUp and not nqUp : false) : false
bearCorrConfirm = useCorrelation ? (isNQ ? not esUp and gcUp : isES ? not nqUp and gcUp : isGC ? esUp and nqUp : false) : false

// Real correlation coefficients, shown in the table for transparency.
otherCorr1     = isNQ ? ta.correlation(close, esClose, corrLen) : isES ? ta.correlation(close, nqClose, corrLen) : isGC ? ta.correlation(close, esClose, corrLen) : na
otherCorr1Name = isNQ ? "ES" : isES ? "NQ" : isGC ? "ES" : ""
otherCorr2     = isNQ ? ta.correlation(close, gcClose, corrLen) : isES ? ta.correlation(close, gcClose, corrLen) : isGC ? ta.correlation(close, nqClose, corrLen) : na
otherCorr2Name = isNQ ? "GC" : isES ? "GC" : isGC ? "NQ" : ""

// ------------------------------------------------------------------- Confluence (of 5)
// Single source of truth for both the score and the human-readable "why" — used live
// in the status table and again, unchanged, on the call label when a call fires.
buildReasons(isCallBull) =>
    momentumHit = isCallBull ? bullMomentum : bearMomentum
    corrHit     = isCallBull ? bullCorrConfirm : bearCorrConfirm
    sweepHit    = isCallBull ? bullSweep : bearSweep
    volHit      = isCallBull ? bullVolConfirm : bearVolConfirm
    tags = array.new<string>()
    if inConfluenceZone
        array.push(tags, "Confluence Zone")
    else if entryZoneTouch
        array.push(tags, "Entry Zone Retest")
    if momentumHit
        array.push(tags, "Momentum")
    if volHit
        array.push(tags, "Volume")
    if corrHit
        array.push(tags, "Cross-Market")
    if sweepHit
        array.push(tags, "Liquidity Sweep")
    score = (inConfluenceZone ? 1 : 0) + (momentumHit ? 1 : 0) + (volHit ? 1 : 0) + (corrHit ? 1 : 0) + (sweepHit ? 1 : 0)
    [score, array.join(tags, ", ")]

[bullScore, bullReasons] = buildReasons(true)
[bearScore, bearReasons] = buildReasons(false)

bullFactors = bullScore
bearFactors = bearScore

// A close through the Breakout Pattern level (0.786) toward the origin means the
// break of structure failed — invalidate the current bias.
breakoutPtnBroken = isBull ? close < breakoutPtn : isBear ? close > breakoutPtn : false

var int lastSignalBar = na
cooledDown = na(lastSignalBar) or (bar_index - lastSignalBar) > cooldownBars

bullSetup = isBull and inPullbackZone and bullReversalBar and not breakoutPtnBroken and (not requireHtfAlignment or htfUptrend) and (not useSessionFilter or inSession) and (not requireTrendStrength or trending)
bearSetup = isBear and inPullbackZone and bearReversalBar and not breakoutPtnBroken and (not requireHtfAlignment or htfDowntrend) and (not useSessionFilter or inSession) and (not requireTrendStrength or trending)

bullCall = bullSetup and bullFactors >= minConfluence and cooledDown and barstate.isconfirmed
bearCall = bearSetup and bearFactors >= minConfluence and cooledDown and barstate.isconfirmed

if bullCall or bearCall
    lastSignalBar := bar_index

// ------------------------------------------------------------------------ Trade plan
bullStop = breakoutPtn - atr * atrMultStop
bearStop = breakoutPtn + atr * atrMultStop

stopLevel = isBull ? bullStop : isBear ? bearStop : na
plot(showLevels ? stopLevel : na, "Stop Loss", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)

// ------------------------------------------------------------------------------ Labels
buildCallText(isCallBull, factors, reasonsStr, entry, stop, t1, t2, a) =>
    dir = isCallBull ? "LONG" : "SHORT"
    rr1 = math.abs(t1 - entry) / math.abs(entry - stop)
    rr2 = math.abs(t2 - entry) / math.abs(entry - stop)
    rrA = math.abs(a - entry) / math.abs(entry - stop)
    dir + " — " + syminfo.root + " (" + str.tostring(factors) + "/5)\n" +
     "Why: " + reasonsStr + "\n" +
     "Entry " + str.tostring(entry, format.mintick) + " | Stop " + str.tostring(stop, format.mintick) + "\n" +
     "TP1 " + str.tostring(t1, format.mintick) + " (R " + str.tostring(rr1, "#.#") + ")" +
     " | TP2 " + str.tostring(t2, format.mintick) + " (R " + str.tostring(rr2, "#.#") + ")" +
     " | Alpha " + str.tostring(a, format.mintick) + " (R " + str.tostring(rrA, "#.#") + ")"

if bullCall
    bullText = buildCallText(true, bullFactors, bullReasons, close, bullStop, tp1, tp2, alpha)
    label.new(bar_index, low - atr, bullText, style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)
    alert(bullText, alert.freq_once_per_bar_close)

if bearCall
    bearText = buildCallText(false, bearFactors, bearReasons, close, bearStop, tp1, tp2, alpha)
    label.new(bar_index, high + atr, bearText, style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.small)
    alert(bearText, alert.freq_once_per_bar_close)

// --------------------------------------------------------------------------- Alerts
// Named conditions (fixed message — pick one of these in the Create Alert dialog for a
// simple ping), or select "Any alert() function call" to get the full dynamic message
// with real entry/stop/TP/Alpha levels built above.
alertcondition(bullCall, "Institutional Long Call", "Institutional Fib Confluence: LONG setup on {{ticker}} — {{close}}")
alertcondition(bearCall, "Institutional Short Call", "Institutional Fib Confluence: SHORT setup on {{ticker}} — {{close}}")
alertcondition(breakoutPtnBroken, "Structure Invalidated", "Institutional Fib Confluence: Breakout Pattern level broken on {{ticker}} — bias invalidated")

// --------------------------------------------------------------------------- Status table
var table statusTable = table.new(position.top_right, 2, 9, border_width = 1)

if showTable and barstate.islast
    biasCore  = isBull ? "BULL BOS" : isBear ? "BEAR BOS" : "NONE"
    htfSuffix = not requireHtfAlignment or not (isBull or isBear) ? "" : (isBull and htfUptrend) or (isBear and htfDowntrend) ? " (HTF ok)" : " (HTF conflict)"
    zoneLabel = inConfluenceZone ? "Confluence" : entryZoneTouch ? "Entry Retest" : "—"
    activeFactors = isBull ? bullFactors : isBear ? bearFactors : 0
    activeReasons = isBull ? bullReasons : isBear ? bearReasons : ""
    confText  = str.tostring(activeFactors) + "/5" + (activeReasons != "" ? " — " + activeReasons : "")
    activeStop = isBull ? bullStop : isBear ? bearStop : na
    stopText  = (isBull or isBear) ? str.tostring(activeStop, format.mintick) : "—"
    rr1 = (isBull or isBear) ? math.abs(tp1 - close) / math.abs(close - activeStop) : na
    rr2 = (isBull or isBear) ? math.abs(tp2 - close) / math.abs(close - activeStop) : na
    rrA = (isBull or isBear) ? math.abs(alpha - close) / math.abs(close - activeStop) : na
    rrText = (isBull or isBear) ? str.tostring(rr1, "#.#") + " / " + str.tostring(rr2, "#.#") + " / " + str.tostring(rrA, "#.#") : "—"
    corrText = otherCorr1Name + " " + str.tostring(otherCorr1, "#.##") + " / " + otherCorr2Name + " " + str.tostring(otherCorr2, "#.##")
    obvArrow = obvUp ? "UP" : obvDown ? "DOWN" : "FLAT"
    volText  = "RVOL " + str.tostring(rvol, "#.#") + "x | OBV " + obvArrow + " | CMF " + str.tostring(cmf, "#.##")
    vwapDiff = close - vwapVal
    vwapText = close > vwapVal ? "Above (+" + str.tostring(vwapDiff, format.mintick) + ")" : close < vwapVal ? "Below (" + str.tostring(vwapDiff, format.mintick) + ")" : "At"
    trendText = "ADX " + str.tostring(adxVal, "#.#") + (trending ? " (trending)" : " (choppy)")

    table.cell(statusTable, 0, 0, "Bias", bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 1, 0, syminfo.root + " — " + biasCore + htfSuffix, bgcolor = color.new(color.gray, 60))
    table.cell(statusTable, 0, 1, "Zone")
    table.cell(statusTable, 1, 1, zoneLabel)
    table.cell(statusTable, 0, 2, "Confluence")
    table.cell(statusTable, 1, 2, confText)
    table.cell(statusTable, 0, 3, "Stop")
    table.cell(statusTable, 1, 3, stopText)
    table.cell(statusTable, 0, 4, "R:R (TP1/TP2/Alpha)")
    table.cell(statusTable, 1, 4, rrText)
    table.cell(statusTable, 0, 5, "Volume")
    table.cell(statusTable, 1, 5, volText)
    table.cell(statusTable, 0, 6, "VWAP")
    table.cell(statusTable, 1, 6, vwapText)
    table.cell(statusTable, 0, 7, "Trend Strength")
    table.cell(statusTable, 1, 7, trendText)
    table.cell(statusTable, 0, 8, "Correlation")
    table.cell(statusTable, 1, 8, corrText)

// ---------------------------------------------------------------- Invalidation reset
if breakoutPtnBroken
    box.delete(confBox)
    confBox := na
    bias := ""
